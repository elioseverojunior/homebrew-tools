# Generated from packaging/homebrew/tflint.rb.in by `mise run homebrew:render`.
# Edit the template, not this file.
# Originally generated by GoReleaser (terraform-linters/homebrew-tap).
cask "tflint" do
  version "${VERSION}"

  on_macos do
    on_arm do
      sha256 "${SHA256_DARWIN_ARM64}"
      url "https://github.com/terraform-linters/tflint/releases/download/v#{version}/tflint_darwin_arm64.zip"
    end
    on_intel do
      sha256 "${SHA256_DARWIN_AMD64}"
      url "https://github.com/terraform-linters/tflint/releases/download/v#{version}/tflint_darwin_amd64.zip"
    end
  end
  on_linux do
    on_arm do
      sha256 "${SHA256_LINUX_ARM64}"
      url "https://github.com/terraform-linters/tflint/releases/download/v#{version}/tflint_linux_arm64.zip"
    end
    on_intel do
      sha256 "${SHA256_LINUX_AMD64}"
      url "https://github.com/terraform-linters/tflint/releases/download/v#{version}/tflint_linux_amd64.zip"
    end
  end

  name "TFLint"
  desc "Pluggable Terraform linter"
  homepage "https://github.com/terraform-linters/tflint"

  livecheck do
    url :url
    strategy :github_latest
  end

  binary "tflint"

  postflight_steps do
    on_macos do
      run "/usr/bin/xattr", args: ["-dr", "com.apple.quarantine", "{{staged_path}}/tflint"]
    end
  end

  # No zap stanza required
end
