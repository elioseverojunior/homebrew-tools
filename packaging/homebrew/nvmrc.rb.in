# Generated from packaging/homebrew/nvmrc.rb.in by `mise run homebrew:render`.
# Edit the template, not this file.
class Nvmrc < Formula
  desc "Native Rust port of nvm, the Node Version Manager"
  homepage "https://github.com/elioseverojunior/nvmrc"
  license "MIT"

  livecheck do
    url :stable
    strategy :github_latest
  end

  # Only --HEAD compiles. Homebrew ships no bottles for macOS Intel, so a stable
  # source build there would first compile rust and llvm from source (hours).
  head do
    url "https://github.com/elioseverojunior/nvmrc.git", branch: "main"

    depends_on "rust" => :build
  end

  # Each archive holds nvmrc, nvm (the same program under nvm's name) and
  # nvm-exec. Linux uses the static musl builds, which run on any distribution.
  on_macos do
    on_arm do
      url "https://github.com/elioseverojunior/nvmrc/releases/download/v${VERSION}/nvmrc-${VERSION}-aarch64-apple-darwin.tar.gz"
      sha256 "${SHA256_DARWIN_ARM64}"
    end

    on_intel do
      url "https://github.com/elioseverojunior/nvmrc/releases/download/v${VERSION}/nvmrc-${VERSION}-x86_64-apple-darwin.tar.gz"
      sha256 "${SHA256_DARWIN_AMD64}"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/elioseverojunior/nvmrc/releases/download/v${VERSION}/nvmrc-${VERSION}-aarch64-unknown-linux-musl.tar.gz"
      sha256 "${SHA256_LINUX_ARM64}"
    end

    on_intel do
      url "https://github.com/elioseverojunior/nvmrc/releases/download/v${VERSION}/nvmrc-${VERSION}-x86_64-unknown-linux-musl.tar.gz"
      sha256 "${SHA256_LINUX_AMD64}"
    end
  end

  def install
    if build.head?
      # The repository's .cargo/config.toml denies warnings for its own CI; a
      # newer rustc lint must not fail an install, so warnings stay warnings.
      ENV["RUSTFLAGS"] = "--cap-lints=warn"
      system "cargo", "install", *std_cargo_args
    else
      bin.install "nvmrc", "nvm", "nvm-exec"
    end
  end

  test do
    # A --HEAD build reports the version in Cargo.toml, not Homebrew's HEAD-<sha>.
    expected = version.head? ? /\Anvm \d+\.\d+\.\d+/ : /\Anvm #{Regexp.escape(version.to_s)}\z/
    assert_match expected, shell_output("#{bin}/nvmrc --version").strip
    assert_path_exists bin/"nvm-exec"

    # An alias is plain state under $NVM_DIR, so this exercises the real
    # command path without touching the network.
    ENV["NVM_DIR"] = testpath
    system bin/"nvm", "alias", "homebrew", "20.1.0"
    assert_equal "20.1.0", (testpath/"alias/homebrew").read.strip
  end
end
